# WhatsApp y teléfono por sede. Si se dejan vacíos, se usa el número publicado.
LUVANIA_WA_RESTREPO=
LUVANIA_PHONE_RESTREPO=
LUVANIA_WA_MODELIA=
LUVANIA_PHONE_MODELIA=
LUVANIA_WA_CHICO=
LUVANIA_PHONE_CHICO=
LUVANIA_WA_VENECIA=
LUVANIA_PHONE_VENECIA=
LUVANIA_WA_COLINA=
LUVANIA_PHONE_COLINA=

# POST JSON de /api/leads. Sin esta variable el lead se acepta y no se reenvía.
LEAD_WEBHOOK_URL=

# Medición. Vacío = no se carga gtag.
NEXT_PUBLIC_GA_ID=


# Agenda virtual: calendario de Luvania con Meet habilitado y OAuth del organizador.
# Usar el ID completo del calendario, y guardar las credenciales como secretos.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Bloqueo de reservas en el servidor.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 0 = domingo, 1 = lunes. Ejemplo de lunes a viernes.
LUVANIA_MEET_WEEKDAYS=1,2,3,4,5
LUVANIA_MEET_DURATION=30

# Piloto de edición capilar con IA. Solo en vistas previas protegidas.
LUVANIA_HAIR_AI_PREVIEW=false
OPENAI_API_KEY=
